generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A recorded "win" that makes a wallet eligible for a voucher.
model Win {
  id              String   @id @default(uuid())
  walletAddress   String
  competitionName String
  wonAt           DateTime @default(now())
  voucher         Voucher?

  @@index([walletAddress])
}

/// A signed, single-use voucher issued for a Win. Redemption state
/// mirrors the on-chain `redeemed` mapping so the API can answer
/// "can this user still claim?" without an RPC call on every request.
model Voucher {
  id          String    @id @default(uuid())
  tokenId     String    @unique
  recipient   String
  uri         String
  expiresAt   DateTime?
  signature   String
  createdAt   DateTime  @default(now())
  redeemedAt  DateTime?
  win         Win       @relation(fields: [winId], references: [id])
  winId       String    @unique

  @@index([recipient])
}
