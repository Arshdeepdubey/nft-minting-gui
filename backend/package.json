{
  "name": "@nft-minting-gui/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema src/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@nft-minting-gui/shared": "*",
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "siwe": "^2.3.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "@types/node": "^22.4.1",
    "@types/jsonwebtoken": "^9.0.6"
  }
}
